# This configuration file is autogenerated by the container startup script
#
# Soft throttling, enforced for the server block that includes this file:
#
#     include /opt/etc/nginx/conf.d/throttling-server.conf;
#
# The zones are declared once for the whole of nginx (conf.d/throttling.conf),
# but limit_req only acts in a server or location that names them. Only the
# image's default server did, so a child image's own vhosts were never
# throttled, whatever NGINX_SOFT_THROTTLE_ENABLED said. A vhost now opts in with
# the include above and follows the same NGINX_SOFT_THROTTLE_* settings.
#
# The file always exists, and is empty of directives unless throttling is
# enabled, so the include is safe either way. The monitoring server does not
# include it: a probe run with curl would fall in the bot zone.
{{- if eq .Env.NGINX_SOFT_THROTTLE_ENABLED "true" }}

# 'burst' allows for short-lived traffic spikes before rejection; 'nodelay'
# rejects at once, with NGINX_SOFT_THROTTLE_STATUS_CODE, past the burst.

# Global protection: higher burst tolerance for static asset loading.
limit_req zone=global_limit burst={{ .Env.NGINX_SOFT_THROTTLE_GLOBAL_ZONE_BURST }} nodelay;

# Bot mitigation: strict enforcement with minimal burst allowance.
limit_req zone=bot_limit burst={{ .Env.NGINX_SOFT_THROTTLE_BOTS_ZONE_BURST }} nodelay;
{{- end }}
